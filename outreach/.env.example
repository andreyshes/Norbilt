# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Your sending email ─────────────────────────────────────
FROM_EMAIL=hello@norbilt.com
FROM_NAME=Andrey | NORBILT
FROM_PHONE=(360) XXX-XXXX

# ── SMTP settings ──────────────────────────────────────────
# Google Workspace / Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@norbilt.com
SMTP_PASSWORD=your_app_password_here
# ^ Generate at: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Set it to "Mail" + "Other (Custom name)" → name it NORBILT Outreach

# Other providers (Outlook/365):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# Other providers (cPanel/Namecheap/GoDaddy):
# SMTP_HOST=mail.norbilt.com   (or whatever your host provides)
# SMTP_PORT=587
